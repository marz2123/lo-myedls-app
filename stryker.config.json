{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "This is the configuration file for Stryker Mutation Testing",
  "packageManager": "npm",
  "reporters": ["html", "clear-text", "progress", "dashboard"],
  "testRunner": "vitest",
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.spec.ts",
    "!src/**/*.spec.tsx",
    "!src/integrations/supabase/types.ts",
    "!src/vite-env.d.ts"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 50
  },
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "ignoreStatic": true,
  "timeoutMS": 60000,
  "concurrency": 4,
  "mutator": {
    "plugins": ["@stryker-mutator/typescript-checker"]
  },
  "dashboard": {
    "reportType": "full"
  }
}
